# Variables de entorno para Django en Vercel + Supabase

# Base de datos Supabase
# Obtén esto de: https://app.supabase.com/project/[tu-proyecto]/settings/database
DATABASE_URL=postgresql://user:password@host:port/database

# Seguridad
SECRET_KEY=tu-clave-secreta-super-larga-y-aleatoria

# Debug (NUNCA True en producción)
DEBUG=False

# Host permitido (tu dominio en Vercel)
ALLOWED_HOST=catalogo-bibliotecario.vercel.app
